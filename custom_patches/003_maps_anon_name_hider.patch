From: ACE counter-hardening
Subject: [PATCH] proc/maps: hide suspicious anon labels for app UIDs

For app UIDs, hide [anon:*] names that leak linker allocation details.
Root/system behavior is unchanged.

Note: [vdso] is kept as-is since it is a legitimate kernel-provided mapping
present on all Android devices; hiding it causes linker solist vs maps
inconsistency which is itself a detection signal.

--- a/fs/proc/task_mmu.c
+++ b/fs/proc/task_mmu.c
@@ -26,3 +26,4 @@
 
 #include <asm/elf.h>
+#include <linux/cred.h>
 #include <asm/tlb.h>
@@ -318,6 +319,13 @@ show_vma_header_prefix(struct seq_file *m,
 	seq_putc(m, ' ');
 }
 
+static bool susfs_maps_is_app_uid(void)
+{
+	unsigned int uid = from_kuid_munged(&init_user_ns, current_uid());
+
+	return uid >= 10000;
+}
+
 static void
 show_map_vma(struct seq_file *m, struct vm_area_struct *vma)
 {
@@ -340,7 +342,8 @@ show_map_vma(struct seq_file *m, struct vm_area_struct *vma)
 	const char *name = NULL;
 #ifdef CONFIG_KSU_SUSFS_OPEN_REDIRECT
 	char *spoofed_redirected_name = NULL;
 #endif // #ifdef CONFIG_KSU_SUSFS_OPEN_REDIRECT
+	bool hide_for_app = susfs_maps_is_app_uid();
 
 	if (file) {
 		struct inode *inode = file_inode(vma->vm_file);
@@ -359,6 +368,9 @@ show_map_vma(struct seq_file *m, struct vm_area_struct *vma)
 
 	name = arch_vma_name(vma);
 	if (!name) {
+		if (hide_for_app && vma_get_anon_name(vma))
+			name = "/dev/ashmem";
+
 		if (!mm) {
 			name = "[vdso]";
 			goto done;
@@ -377,16 +389,23 @@ show_map_vma(struct seq_file *m, struct vm_area_struct *vma)
 			goto done;
 		}
 
-		if (vma_get_anon_name(vma)) {
-			seq_pad(m, ' ');
-			seq_print_vma_name(m, vma);
-		}
+		if (vma_get_anon_name(vma) && !hide_for_app) {
+			seq_pad(m, ' ');
+			seq_print_vma_name(m, vma);
+		}
 	}
 
 done:
 	if (name) {
+		if (hide_for_app && !strcmp(name, "[anon_shmem]"))
+			name = "/dev/ashmem";
+
 		seq_pad(m, ' ');
 		seq_puts(m, name);
+	} else if (hide_for_app && !file && (flags & VM_EXEC)) {
+		/* Avoid blank executable anonymous lines that trigger naive scanners. */
+		seq_pad(m, ' ');
+		seq_puts(m, "/dev/ashmem");
 	}
 	seq_putc(m, '\n');
 }