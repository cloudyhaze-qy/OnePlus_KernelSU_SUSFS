From: ACE counter-hardening
Subject: [PATCH] module: hide KernelSU module from /proc/modules for app UIDs

For /proc/modules readers running as app UIDs (uid >= 10000), skip
module entries whose names match the deny-list (kernelsu, susfs).
Root/system readers are left unchanged.

current_uid() is available via existing includes in kernel/module.c.

--- a/kernel/module.c
+++ b/kernel/module.c
@@ -4700,3 +4701,14 @@ static int m_show(struct seq_file *m, void *p)
 	/* We always ignore unformed modules. */
 	if (mod->state == MODULE_STATE_UNFORMED)
 		return 0;
+
+	/* Hide KernelSU/SUSFS modules from app UIDs (uid >= 10000). */
+	if (current_uid().val >= 10000) {
+		static const char * const denylist[] = {
+			"kernelsu", "susfs",
+		};
+		int _i;
+		for (_i = 0; _i < ARRAY_SIZE(denylist); _i++)
+			if (strstr(mod->name, denylist[_i]))
+				return 0;
+	}

