From: ACE counter-hardening
Subject: [PATCH] susfs: deep spoof uname into init_uts_ns

Also overwrite init_uts_ns so that /proc/version,
/proc/sys/kernel/osrelease and /proc/sys/kernel/version
reflect the spoofed values for any reader (not only sys_newuname).

This plugs a gap where SUSFS only hooked sys_newuname but left
init_uts_ns raw, letting userspace read the real kernel build
banner via /proc/version etc.

--- a/fs/susfs.c
+++ b/fs/susfs.c
@@ -1,6 +1,7 @@
 #include <linux/version.h>
 #include <linux/cred.h>
 #include <linux/module.h>
+#include <linux/utsname.h>
 #include <linux/susfs.h>
 #include "mount.h"
 
@@ -430,7 +431,7 @@ int susfs_set_uname(struct st_susfs_uname* __user user_info) {
 		SUSFS_LOGE("failed copying from userspace.\n");
 		return 1;
 	}
-
+
 	spin_lock(&susfs_spin_lock);
 	strncpy(my_uname.sysname, info.sysname, __NEW_UTS_LEN);
 	strncpy(my_uname.nodename, info.nodename, __NEW_UTS_LEN);
@@ -440,6 +441,30 @@ int susfs_set_uname(struct st_susfs_uname* __user user_info) {
 	SUSFS_LOGI("setting sysname: '%s', nodename: '%s', release: '%s', version: '%s', machine: '%s'\n",
 				my_uname.sysname, my_uname.nodename, my_uname.release, my_uname.version, my_uname.machine);
 	spin_unlock(&susfs_spin_lock);
+
+	/* Deep spoof: also overwrite init_uts_ns so that any reader of
+	 * /proc/version, /proc/sys/kernel/osrelease, /proc/sys/kernel/version
+	 * sees the spoofed values (not only sys_newuname callers). */
+	down_write(&uts_sem);
+	if (strcmp(my_uname.sysname, "default")) {
+		memset(init_uts_ns.name.sysname, 0, __NEW_UTS_LEN + 1);
+		strncpy(init_uts_ns.name.sysname, my_uname.sysname, __NEW_UTS_LEN);
+	}
+	if (strcmp(my_uname.nodename, "default")) {
+		memset(init_uts_ns.name.nodename, 0, __NEW_UTS_LEN + 1);
+		strncpy(init_uts_ns.name.nodename, my_uname.nodename, __NEW_UTS_LEN);
+	}
+	if (strcmp(my_uname.release, "default")) {
+		memset(init_uts_ns.name.release, 0, __NEW_UTS_LEN + 1);
+		strncpy(init_uts_ns.name.release, my_uname.release, __NEW_UTS_LEN);
+	}
+	if (strcmp(my_uname.version, "default")) {
+		memset(init_uts_ns.name.version, 0, __NEW_UTS_LEN + 1);
+		strncpy(init_uts_ns.name.version, my_uname.version, __NEW_UTS_LEN);
+	}
+	up_write(&uts_sem);
+	SUSFS_LOGI("init_uts_ns overwritten (deep spoof)\n");
+
 	return 0;
 }
 
