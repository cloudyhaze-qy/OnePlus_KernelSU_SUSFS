From: ACE counter-hardening
Subject: [PATCH] susfs: deep spoof uname into init_uts_ns

SUSFS only overrides sys_newuname via its internal my_uname struct,
but leaves init_uts_ns raw. This lets userspace leak the real kernel
build banner via /proc/version, /proc/sys/kernel/osrelease and
/proc/sys/kernel/version (which all read init_uts_ns directly).

Honor of Kings ACE / libtersafe cross-checks uname() vs /proc/version
and flags any mismatch, so we mirror the spoofed release/version into
init_uts_ns whenever susfs_set_uname() updates my_uname.

--- a/fs/susfs.c
+++ b/fs/susfs.c
@@ -18,6 +18,8 @@
 #include <linux/workqueue.h>
 #include <linux/fsnotify_backend.h>
+#include <linux/rwsem.h>
+#include <linux/utsname.h>
 #include <linux/susfs.h>
 #include "fuse/fuse_i.h"
 #include "mount.h"
 
@@ -616,6 +618,14 @@ void susfs_set_uname(void __user **user_info) {
	is_susfs_uname_set = true;
	write_sequnlock(&susfs_uname_seqlock);
+
+	/* Deep spoof: keep procfs readers in sync with sys_newuname(). */
+	down_write(&uts_sem);
+	strscpy(init_uts_ns.name.release, my_uname.release, sizeof(init_uts_ns.name.release));
+	strscpy(init_uts_ns.name.version, my_uname.version, sizeof(init_uts_ns.name.version));
+	up_write(&uts_sem);
+	SUSFS_LOGI("deep spoofed init_uts_ns release: '%s', version: '%s'\n",
+			my_uname.release, my_uname.version);
	SUSFS_LOGI("set spoofed release: '%s', version: '%s'\n",
				my_uname.release, my_uname.version);
 
	info.err = 0;

